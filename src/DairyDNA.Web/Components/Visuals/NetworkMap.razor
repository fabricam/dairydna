@namespace DairyDNA.Web.Components.Visuals
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_mapId"
     class="dd-google-map"
     style="height:@($"{Height}px")"
     role="region"
     aria-label="@AriaLabel">
    <div class="dd-visual-loading">Loading Google Maps…</div>
</div>
<p class="dd-visual-alt">@TextAlternative</p>

@code {
    [Parameter] public IReadOnlyList<NetworkPointVm> Points { get; set; } = [];
    [Parameter] public IReadOnlyList<NetworkFlowVm> Flows { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "United States network map of facilities and customers";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Height { get; set; } = 420;
    [Parameter] public string? ApiKey { get; set; }

    private readonly string _mapId = $"map-{Guid.NewGuid():N}";
    private int _version;
    private int _renderedVersion = -1;
    private int? _dataHash;

    protected override void OnParametersSet()
    {
        var hash = new HashCode();
        hash.Add(ApiKey);
        hash.Add(Height);
        foreach (var point in Points)
            hash.Add(point);
        foreach (var flow in Flows)
            hash.Add(flow);

        var nextHash = hash.ToHashCode();
        if (_dataHash == nextHash)
            return;

        _dataHash = nextHash;
        _version++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_renderedVersion == _version)
            return;

        _renderedVersion = _version;
        var apiKey = ApiKey ?? Configuration["GoogleMaps:ApiKey"] ?? string.Empty;
        await JS.InvokeVoidAsync("dairyDnaMaps.render", _mapId, apiKey, Points, Flows);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dairyDnaMaps.destroy", _mapId);
        }
        catch (JSDisconnectedException)
        {
            // The server-side circuit has already ended.
        }
    }

    public sealed record NetworkPointVm(Guid id, string kind, string name, decimal latitude, decimal longitude);
    public sealed record NetworkFlowVm(Guid originId, Guid destinationId);
}
