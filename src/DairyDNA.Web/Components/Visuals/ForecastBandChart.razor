@namespace DairyDNA.Web.Components.Visuals

@if (Actuals.Count + Forecasts.Count < 2)
{
    <div class="dd-visual-fallback" role="status">No forecast series</div>
}
else
{
    <ChartCanvas Config="@BuildChartConfig()" AriaLabel="@AriaLabel" Height="@Height" />
}
<p class="dd-visual-alt">@TextAlternative</p>
<table class="ui very compact celled table">
    <thead><tr><th>Date</th><th>Series</th><th>Value</th></tr></thead>
    <tbody>
    @foreach (var a in Actuals.TakeLast(10))
    {
        <tr><td>@a.Date</td><td>Actual</td><td>@a.Value.ToString("N0")</td></tr>
    }
    @foreach (var f in Forecasts)
    {
        <tr><td>@f.Date</td><td>Forecast point</td><td>@f.Point.ToString("N0") (L @f.Lower.ToString("N0") / U @f.Upper.ToString("N0"))</td></tr>
    }
    </tbody>
</table>

@code {
    public sealed record ActualVm(DateOnly Date, decimal Value);
    public sealed record ForecastVm(DateOnly Date, decimal Point, decimal Lower, decimal Upper);

    [Parameter] public IReadOnlyList<ActualVm> Actuals { get; set; } = [];
    [Parameter] public IReadOnlyList<ForecastVm> Forecasts { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "Supply forecast with uncertainty bands";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Height { get; set; } = 280;

    private object BuildChartConfig()
    {
        var dates = Actuals.Select(a => a.Date).Concat(Forecasts.Select(f => f.Date)).Distinct().OrderBy(d => d).ToList();
        decimal? Actual(DateOnly date) => Actuals.FirstOrDefault(a => a.Date == date)?.Value;
        decimal? Forecast(DateOnly date, Func<ForecastVm, decimal> select)
        {
            var value = Forecasts.FirstOrDefault(f => f.Date == date);
            return value is null ? null : select(value);
        }

        return new
        {
            type = "line",
            data = new
            {
                labels = dates.Select(d => d.ToString("yyyy-MM-dd")).ToArray(),
                datasets = new object[]
                {
                    new
                    {
                        label = "Forecast lower",
                        data = dates.Select(d => Forecast(d, f => f.Lower)).ToArray(),
                        borderColor = "rgba(10, 147, 150, 0)",
                        backgroundColor = "rgba(148, 210, 189, 0.4)",
                        pointRadius = 0,
                        spanGaps = false
                    },
                    new
                    {
                        label = "Forecast interval",
                        data = dates.Select(d => Forecast(d, f => f.Upper)).ToArray(),
                        borderColor = "rgba(10, 147, 150, 0)",
                        backgroundColor = "rgba(148, 210, 189, 0.4)",
                        pointRadius = 0,
                        fill = "-1",
                        spanGaps = false
                    },
                    new
                    {
                        label = "Forecast point",
                        data = dates.Select(d => Forecast(d, f => f.Point)).ToArray(),
                        borderColor = "#0a9396",
                        backgroundColor = "#0a9396",
                        borderDash = new[] { 6, 4 },
                        pointRadius = 2,
                        tension = 0.15,
                        spanGaps = false
                    },
                    new
                    {
                        label = "Actual",
                        data = dates.Select(Actual).ToArray(),
                        borderColor = "#243447",
                        backgroundColor = "#243447",
                        pointRadius = 2,
                        tension = 0.15,
                        spanGaps = false
                    }
                }
            },
            options = new
            {
                interaction = new { mode = "index", intersect = false },
                scales = new
                {
                    x = new { title = new { display = true, text = "Date" } },
                    y = new { title = new { display = true, text = "Value" } }
                }
            }
        };
    }
}
