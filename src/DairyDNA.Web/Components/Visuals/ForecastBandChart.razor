@namespace DairyDNA.Web.Components.Visuals

@((MarkupString)SvgMarkup)
<p class="dd-visual-alt">@TextAlternative</p>
<table class="ui very compact celled table">
    <thead><tr><th>Date</th><th>Series</th><th>Value</th></tr></thead>
    <tbody>
    @foreach (var a in Actuals.TakeLast(10))
    {
        <tr><td>@a.Date</td><td>Actual</td><td>@a.Value.ToString("N0")</td></tr>
    }
    @foreach (var f in Forecasts)
    {
        <tr><td>@f.Date</td><td>Forecast point</td><td>@f.Point.ToString("N0") (L @f.Lower.ToString("N0") / U @f.Upper.ToString("N0"))</td></tr>
    }
    </tbody>
</table>

@code {
    public sealed record ActualVm(DateOnly Date, decimal Value);
    public sealed record ForecastVm(DateOnly Date, decimal Point, decimal Lower, decimal Upper);

    [Parameter] public IReadOnlyList<ActualVm> Actuals { get; set; } = [];
    [Parameter] public IReadOnlyList<ForecastVm> Forecasts { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "Supply forecast with uncertainty bands";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Width { get; set; } = 720;
    [Parameter] public int Height { get; set; } = 280;

    private string SvgMarkup { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg class=\"dd-forecast-chart\" viewBox=\"0 0 {Width} {Height}\" role=\"img\" aria-label=\"{System.Net.WebUtility.HtmlEncode(AriaLabel)}\">");
        sb.Append($"<title>{System.Net.WebUtility.HtmlEncode(AriaLabel)}</title>");
        sb.Append($"<rect width=\"{Width}\" height=\"{Height}\" class=\"dd-chart-bg\" />");

        var dates = Actuals.Select(a => a.Date).Concat(Forecasts.Select(f => f.Date)).Distinct().OrderBy(d => d).ToList();
        if (dates.Count < 2)
        {
            sb.Append($"<text x=\"{Width / 2}\" y=\"{Height / 2}\" text-anchor=\"middle\" class=\"dd-chart-empty\">No forecast series</text>");
            sb.Append("</svg>");
            SvgMarkup = sb.ToString();
            return;
        }

        var values = Actuals.Select(a => a.Value)
            .Concat(Forecasts.SelectMany(f => new[] { f.Lower, f.Upper, f.Point }))
            .DefaultIfEmpty(0).ToList();
        var min = values.Min();
        var max = values.Max();
        if (max <= min) max = min + 1;

        double X(DateOnly d)
        {
            var i = dates.IndexOf(d);
            return 40 + i * (Width - 60.0) / Math.Max(1, dates.Count - 1);
        }
        double Y(decimal v) => Height - 30 - (double)((v - min) / (max - min)) * (Height - 50);

        // Band polygon
        if (Forecasts.Count >= 2)
        {
            var ordered = Forecasts.OrderBy(f => f.Date).ToList();
            var top = string.Join(" ", ordered.Select(f => $"{X(f.Date):0.##},{Y(f.Upper):0.##}"));
            var bottom = string.Join(" ", ordered.AsEnumerable().Reverse().Select(f => $"{X(f.Date):0.##},{Y(f.Lower):0.##}"));
            sb.Append($"<polygon points=\"{top} {bottom}\" class=\"dd-forecast-band\" />");
            var line = string.Join(" ", ordered.Select((f, i) => $"{(i == 0 ? "M" : "L")}{X(f.Date):0.##},{Y(f.Point):0.##}"));
            sb.Append($"<path d=\"{line}\" class=\"dd-forecast-point\" fill=\"none\" />");
        }

        if (Actuals.Count >= 2)
        {
            var ordered = Actuals.OrderBy(a => a.Date).ToList();
            var line = string.Join(" ", ordered.Select((a, i) => $"{(i == 0 ? "M" : "L")}{X(a.Date):0.##},{Y(a.Value):0.##}"));
            sb.Append($"<path d=\"{line}\" class=\"dd-forecast-actual\" fill=\"none\" />");
        }

        sb.Append("<text x=\"48\" y=\"18\" class=\"dd-chart-label\">Actual (solid) · Forecast band (shaded) · Point (dashed)</text>");
        sb.Append("</svg>");
        SvgMarkup = sb.ToString();
    }
}
