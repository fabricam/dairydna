@namespace DairyDNA.Web.Components.Visuals

@if (Bars.Count == 0)
{
    <div class="dd-visual-fallback" role="status">No movements</div>
}
else
{
    <ChartCanvas Config="@BuildChartConfig()" AriaLabel="@AriaLabel" Height="@Height" />
}
<p class="dd-visual-alt">@TextAlternative</p>

@code {
    [Parameter] public IReadOnlyList<MarginBarVm> Bars { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "Contribution margin and cost breakdown chart";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Height { get; set; } = 280;

    private object BuildChartConfig()
    {
        return new
        {
            type = "bar",
            data = new
            {
                labels = Bars.Select((_, index) => $"M{index + 1}").ToArray(),
                datasets = new object[]
                {
                    new { label = "Revenue", data = Bars.Select(b => b.revenue).ToArray(), backgroundColor = "#1f4e79" },
                    new { label = "Transport", data = Bars.Select(b => b.transport).ToArray(), backgroundColor = "#e9c46a" },
                    new { label = "Margin", data = Bars.Select(b => b.margin).ToArray(), backgroundColor = "#2a9d8f" }
                }
            },
            options = new
            {
                scales = new
                {
                    x = new { title = new { display = true, text = "Movement" } },
                    y = new { beginAtZero = true, title = new { display = true, text = "Amount" } }
                }
            }
        };
    }

    public sealed record MarginBarVm(decimal revenue, decimal transport, decimal margin);
}
