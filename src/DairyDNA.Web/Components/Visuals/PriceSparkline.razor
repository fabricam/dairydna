@namespace DairyDNA.Web.Components.Visuals

@if (FilteredPoints.Count < 2)
{
    <div class="dd-visual-fallback" role="status">Insufficient price points</div>
}
else
{
    <ChartCanvas Config="@BuildChartConfig()" AriaLabel="@AriaLabel" Height="@Height" />
}
<p class="dd-visual-alt">@TextAlternative</p>
<table class="ui very compact celled table">
    <thead><tr><th>Date</th><th>Product</th><th>Price/lb</th><th>Class</th></tr></thead>
    <tbody>
    @foreach (var p in Points.TakeLast(20))
    {
        <tr><td>@p.Date</td><td>@p.ProductCode</td><td>@p.PricePerPound</td><td>@p.Classification</td></tr>
    }
    </tbody>
</table>

@code {
    public sealed record PriceVm(DateOnly Date, string ProductCode, decimal PricePerPound, string Classification);

    [Parameter] public IReadOnlyList<PriceVm> Points { get; set; } = [];
    [Parameter] public string ProductCode { get; set; } = "RAW_MILK";
    [Parameter] public string AriaLabel { get; set; } = "Price time series";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Height { get; set; } = 180;

    private List<PriceVm> FilteredPoints => Points
        .Where(p => p.ProductCode.Equals(ProductCode, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.Date)
        .ToList();

    private object BuildChartConfig()
    {
        var series = FilteredPoints;
        var dates = series.Select(p => p.Date).Distinct().OrderBy(d => d).ToList();
        decimal? Value(DateOnly date, string classification)
        {
            var point = series.FirstOrDefault(p =>
                p.Date == date && p.Classification.Equals(classification, StringComparison.OrdinalIgnoreCase));
            return point?.PricePerPound;
        }

        return new
        {
            type = "line",
            data = new
            {
                labels = dates.Select(d => d.ToString("yyyy-MM-dd")).ToArray(),
                datasets = new object[]
                {
                    new
                    {
                        label = "Synthetic",
                        data = dates.Select(d => Value(d, "Synthetic")).ToArray(),
                        borderColor = "#1f4e79",
                        backgroundColor = "#1f4e79",
                        pointRadius = 1.5,
                        tension = 0.2,
                        spanGaps = true
                    },
                    new
                    {
                        label = "Public",
                        data = dates.Select(d => Value(d, "Public")).ToArray(),
                        borderColor = "#0077b6",
                        backgroundColor = "#0077b6",
                        borderDash = new[] { 5, 3 },
                        pointRadius = 1.5,
                        tension = 0.2,
                        spanGaps = true
                    }
                }
            },
            options = new
            {
                interaction = new { mode = "index", intersect = false },
                scales = new
                {
                    x = new { title = new { display = true, text = "Date" } },
                    y = new { title = new { display = true, text = "Price per lb" } }
                }
            }
        };
    }
}
