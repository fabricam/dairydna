@namespace DairyDNA.Web.Components.Visuals

@if (Buckets.Count == 0)
{
    <div class="dd-visual-fallback" role="status">No inventory lots</div>
}
else
{
    <ChartCanvas Config="@BuildChartConfig()" AriaLabel="@AriaLabel" Height="@Height" />
}
<p class="dd-visual-alt">@TextAlternative</p>
<table class="ui very compact celled table">
    <thead><tr><th>Age band</th><th>Lots</th><th>Qty (lb)</th><th>Risk</th></tr></thead>
    <tbody>
    @foreach (var b in Buckets)
    {
        <tr><td>@b.Band</td><td>@b.LotCount</td><td>@b.QuantityPounds.ToString("N0")</td><td>@b.RiskLevel</td></tr>
    }
    </tbody>
</table>

@code {
    public sealed record BucketVm(string Band, int LotCount, decimal QuantityPounds, string RiskLevel);

    [Parameter] public IReadOnlyList<BucketVm> Buckets { get; set; } = [];
    [Parameter] public string AriaLabel { get; set; } = "Inventory age and spoilage risk chart";
    [Parameter] public string TextAlternative { get; set; } = string.Empty;
    [Parameter] public int Height { get; set; } = 220;

    private object BuildChartConfig()
    {
        string Color(BucketVm bucket) => bucket.RiskLevel switch
        {
            "Critical" => "#9b2226",
            "High" => "#ca6702",
            "Moderate" => "#ee9b00",
            _ => "#0a9396"
        };

        return new
        {
            type = "bar",
            data = new
            {
                labels = Buckets.Select(b => $"{b.Band} ({b.LotCount} lots)").ToArray(),
                datasets = new[]
                {
                    new
                    {
                        label = "Quantity (lb)",
                        data = Buckets.Select(b => b.QuantityPounds).ToArray(),
                        backgroundColor = Buckets.Select(Color).ToArray(),
                        borderWidth = 0
                    }
                }
            },
            options = new
            {
                plugins = new { legend = new { display = false } },
                scales = new
                {
                    x = new { title = new { display = true, text = "Age band" } },
                    y = new { beginAtZero = true, title = new { display = true, text = "Quantity (lb)" } }
                }
            }
        };
    }
}
