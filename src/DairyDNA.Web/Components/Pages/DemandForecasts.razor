@page "/forecasts/demand"
@rendermode InteractiveServer
@using DairyDNA.Web.Components.Visuals
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Demand forecasts</PageTitle>

<div class="ui container" style="margin-top:2em;">
    <h1 class="ui header">Demand forecasts
        <div class="sub header">Customer demand horizons with uncertainty — estimates only</div>
    </h1>
    <div class="ui warning message">
        <strong>Forecast</strong> values are estimates. <strong>Open orders</strong> are committed requests and are shown separately.
    </div>
    <div class="ui form segment">
        <div class="inline fields">
            <div class="field"><label>Generation</label><select @onchange="OnPickGen"><option value="">Select…</option>@foreach (var g in _generations) { <option value="@g.id">@g.profileName · @g.id</option> }</select></div>
            <button class="ui primary button" disabled="@(_generationId is null || _busy)" @onclick="RunAsync">Train &amp; publish</button>
        </div>
    </div>
    @if (_error is not null) { <div class="ui negative message">@_error</div> }
    @if (_model is not null) { <div class="ui segment"><div class="ui olive label">Forecast</div><p>Model @_model.id · @_model.algorithm · Status @_model.status · Meets bar @_model.meetsAcceptanceBar</p><p>@_model.notes</p></div> }
    @if (_customers.Count > 0)
    {
        <h3 class="ui header">Customer picker <div class="ui teal label">Synthetic</div></h3>
        <div class="ui segment"><div class="ui horizontal list">@foreach (var customer in _customers) { <a class="item @(customer.id == _selectedCustomer ? "active" : null)" href="javascript:void(0)" @onclick="() => SelectCustomer(customer.id)">@customer.name</a> }</div></div>
    }
    @if (_selectedCustomer is not null)
    {
        <h3 class="ui header">Forecast bands <div class="ui olive label">Forecast</div></h3>
        <div class="ui segment dd-visual-panel"><ForecastBandChart Actuals="_openOrders" Forecasts="_forecasts" TextAlternative="Open orders as solid history; demand forecast point with lower and upper uncertainty band." /></div>
        <p class="ui tiny message"><strong>Open orders:</strong> historical customer order requests. <strong>Forecast:</strong> projected demand with uncertainty bounds.</p>
    }
</div>

@code {
    private List<GenDto> _generations = [];
    private Guid? _generationId, _selectedCustomer;
    private ModelDto? _model;
    private List<CustomerDto> _customers = [];
    private List<ForecastBandChart.ActualVm> _openOrders = [];
    private List<ForecastBandChart.ForecastVm> _forecasts = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => _generations = await HttpClientFactory.CreateClient("DairyDNA.Api").GetFromJsonAsync<List<GenDto>>("api/generation-runs") ?? [];
    private void OnPickGen(ChangeEventArgs e) => _generationId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    private async Task RunAsync()
    {
        if (_generationId is null) return;
        _busy = true; _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("DairyDNA.Api");
            var response = await client.PostAsJsonAsync("api/forecasts/demand/runs", new { generationId = _generationId, randomSeed = 104729 });
            if (!response.IsSuccessStatusCode) { _error = await response.Content.ReadAsStringAsync(); return; }
            _model = await response.Content.ReadFromJsonAsync<ModelDto>();
            var dashboard = await client.GetFromJsonAsync<DashDto>($"api/dashboard?generationId={_generationId}");
            _customers = dashboard?.network?.Where(x => x.kind == "Customer").Select(x => new CustomerDto(x.id, x.name)).ToList() ?? [];
            if (_customers.Count > 0) await SelectCustomer(_customers[0].id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private async Task SelectCustomer(Guid id)
    {
        _selectedCustomer = id;
        if (_generationId is null) return;
        var client = HttpClientFactory.CreateClient("DairyDNA.Api");
        var actuals = await client.GetFromJsonAsync<ActualsDto>($"api/forecasts/demand/actuals?generationId={_generationId}&customerId={id}");
        _openOrders = actuals?.items?.Select(x => new ForecastBandChart.ActualVm(x.date, x.actualPounds)).ToList() ?? [];
        var forecasts = await client.GetFromJsonAsync<ForecastsDto>($"api/forecasts/demand?generationId={_generationId}&customerId={id}");
        _forecasts = forecasts?.items?.Where(x => x.productCode == "RAW_MILK" && x.aggregationLevel == "Customer").Select(x => new ForecastBandChart.ForecastVm(x.targetDate, x.pointEstimatePounds, x.lowerBoundPounds, x.upperBoundPounds)).ToList() ?? [];
    }
    private sealed record GenDto(Guid id, string? profileName);
    private sealed record CustomerDto(Guid id, string name);
    private sealed record ModelDto(Guid id, string algorithm, string status, bool meetsAcceptanceBar, string? notes);
    private sealed record DashDto(List<NetDto>? network);
    private sealed record NetDto(Guid id, string kind, string name);
    private sealed record ActualsDto(List<ActDto>? items);
    private sealed record ActDto(DateOnly date, decimal actualPounds);
    private sealed record ForecastsDto(List<FcDto>? items);
    private sealed record FcDto(string productCode, string aggregationLevel, DateOnly targetDate, decimal pointEstimatePounds, decimal lowerBoundPounds, decimal upperBoundPounds);
}
