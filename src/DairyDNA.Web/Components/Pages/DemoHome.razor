@page "/"
@page "/demo"
@rendermode InteractiveServer
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using DairyDNA.Web.Components.Visuals
@inject IDispatcher Dispatcher
@inject IState<GenerationState> GenerationState
@inject IState<DemoState> DemoState
@inject IState<OptimizationState> OptimizationState
@inject IHttpClientFactory HttpClientFactory

<PageTitle>DairyDNA Demo</PageTitle>

<div class="ui container" style="margin-top:2em;">
    <h1 class="ui header">DairyDNA <div class="sub header">Synthetic data generation &amp; allocation demo</div></h1>

    <div class="ui warning message">
        Local-dev demonstration only. Unauthenticated. Not production-secure. Recommendations are not market advice.
    </div>

    <div class="ui form segment">
        <h3 class="ui dividing header">Generation profile</h3>
        <div class="inline fields">
            <div class="field">
                <label>Profile</label>
                <select class="ui dropdown" @bind="_profileName">
                    <option value="thin-slice">thin-slice (5/2/5/3, milk+cream, ~90d)</option>
                    <option value="standard-demo">standard-demo (150/8/75/30, 6 products, ~3y)</option>
                    <option value="custom">custom (override counts)</option>
                </select>
            </div>
            <div class="field">
                <label>Seed</label>
                <input type="number" @bind="_seed" style="width:8em;" />
            </div>
        </div>
        @if (_profileName == "custom")
        {
            <div class="inline fields">
                <div class="field"><label>Farms</label><input type="number" @bind="_farmCount" style="width:6em;" /></div>
                <div class="field"><label>Facilities</label><input type="number" @bind="_facilityCount" style="width:6em;" /></div>
                <div class="field"><label>Customers</label><input type="number" @bind="_customerCount" style="width:6em;" /></div>
                <div class="field"><label>Trucks</label><input type="number" @bind="_truckCount" style="width:6em;" /></div>
            </div>
        }
        <button type="button" class="ui primary button @(GenerationState.Value.Loading ? "loading" : null)"
                disabled="@GenerationState.Value.Loading" @onclick="GenerateAsync">
            @(GenerationState.Value.Loading ? "Generating..." : "Generate synthetic data")
        </button>
    </div>

    @if (GenerationState.Value.Error is not null)
    {
        <div class="ui negative message">@GenerationState.Value.Error</div>
    }

    @if (GenerationState.Value.GenerationId is Guid gid)
    {
        <div class="ui segment">
            <p><strong>Generation:</strong> @gid</p>
            <p>
                <strong>Profile:</strong> @(GenerationState.Value.ProfileName ?? "—") ·
                <strong>Seed:</strong> @GenerationState.Value.RandomSeed ·
                <strong>Status:</strong> @GenerationState.Value.Status ·
                <strong>Planning date:</strong> @GenerationState.Value.PlanningDate
            </p>
            <button class="ui button" disabled="@DemoState.Value.Loading" @onclick="() => LoadSummary(gid)">Load demo summary</button>
            <button class="ui teal button" disabled="@OptimizationState.Value.Loading" @onclick="() => Optimize(gid)">Run optimization</button>
            <a class="ui button" href="/recommendations">View recommendations</a>
            @if (_validationReport is not null)
            {
                <div class="ui @( _validationReport.passed ? "positive" : "negative") message" style="margin-top:1em;">
                    Validation: @(_validationReport.passed ? "Passed" : "Failed") ·
                    missingness @(_validationReport.observedMissingnessRate.ToString("P1")) ·
                    seasonal @(_validationReport.seasonalVariationDetected ? "detected" : "not detected")
                </div>
            }
            else
            {
                <button class="ui basic button" @onclick="() => LoadValidation(gid)">Load validation report</button>
            }
        </div>
    }

    @if (DemoState.Value.Summary is { } summary)
    {
        <h2 class="ui header">Operational summary <div class="ui teal label">@summary.dataClassification</div></h2>
        <div class="ui three cards">
            <div class="card"><div class="content"><div class="header">Inventory rows</div><div class="description">@summary.inventory.Count</div></div></div>
            <div class="card"><div class="content"><div class="header">Open demand</div><div class="description">@summary.demand.Count</div></div></div>
            <div class="card"><div class="content"><div class="header">Fleet</div><div class="description">@summary.fleet.Count</div></div></div>
        </div>

        <h3 class="ui header">Network map <div class="ui teal label">@summary.dataClassification</div></h3>
        <div class="ui segment dd-visual-panel">
            <NetworkMap Points="ToMapPoints(summary.network)"
                        AriaLabel="Google map of facilities and customers"
                        TextAlternative="@NetworkAltText(summary.network)" />
            <div class="dd-map-legend">
                <span class="dd-legend-farm">■ Farm</span>
                <span class="dd-legend-facility">■ Facility</span>
                <span class="dd-legend-customer">■ Customer</span>
            </div>
        </div>

        <h3 class="ui header">Inventory</h3>
        <table class="ui celled table">
            <thead><tr><th>Facility</th><th>Product</th><th>Qty (lb)</th><th>Oldest expiry</th></tr></thead>
            <tbody>
            @foreach (var row in summary.inventory)
            {
                <tr><td>@row.facilityName</td><td>@row.productCode</td><td>@row.quantityPounds</td><td>@row.oldestExpiresAt</td></tr>
            }
            </tbody>
        </table>

        <h3 class="ui header">Demand</h3>
        <table class="ui celled table">
            <thead><tr><th>Customer</th><th>Product</th><th>Qty</th><th>Price/lb</th></tr></thead>
            <tbody>
            @foreach (var row in summary.demand)
            {
                <tr><td>@row.customerName</td><td>@row.productCode</td><td>@row.requestedQuantityPounds</td><td>@row.offeredPricePerPound</td></tr>
            }
            </tbody>
        </table>
    }
</div>

@code {
    private string _profileName = "thin-slice";
    private int _seed = 104729;
    private int _farmCount = 5;
    private int _facilityCount = 2;
    private int _customerCount = 5;
    private int _truckCount = 3;
    private ValidationReportDto? _validationReport;

    private Task GenerateAsync()
    {
        _validationReport = null;
        if (_profileName == "custom")
        {
            Dispatcher.Dispatch(new GenerateSyntheticAction(
                "custom", _seed, _farmCount, _facilityCount, _customerCount, _truckCount));
        }
        else
        {
            Dispatcher.Dispatch(new GenerateSyntheticAction(_profileName, _seed));
        }
        return Task.CompletedTask;
    }

    private void LoadSummary(Guid id) => Dispatcher.Dispatch(new LoadDemoSummaryAction(id));
    private void Optimize(Guid id) => Dispatcher.Dispatch(new RunOptimizationAction(id));

    private async Task LoadValidation(Guid id)
    {
        var client = HttpClientFactory.CreateClient("DairyDNA.Api");
        _validationReport = await client.GetFromJsonAsync<ValidationReportDto>($"api/generation-runs/{id}/validation-report");
    }

    private static List<NetworkMap.NetworkPointVm> ToMapPoints(List<NetworkPointDto> network) =>
        network.Select(p => new NetworkMap.NetworkPointVm(p.id, p.kind, p.name, p.latitude, p.longitude)).ToList();

    private static string NetworkAltText(List<NetworkPointDto> network)
    {
        var farms = network.Count(p => p.kind.Equals("Farm", StringComparison.OrdinalIgnoreCase));
        var facilities = network.Count(p => p.kind.Equals("Facility", StringComparison.OrdinalIgnoreCase));
        var customers = network.Count(p => p.kind.Equals("Customer", StringComparison.OrdinalIgnoreCase));
        return $"United States Google map shows {farms} farms, {facilities} facilities, and {customers} customers plotted by location.";
    }

    private sealed record ValidationReportDto(bool passed, decimal observedMissingnessRate, bool seasonalVariationDetected);
}
